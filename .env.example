APP_NAME=MYIA
APP_ENV=development
LOG_LEVEL=INFO

# ── Jira (optional) ───────────────────────────────────────────────────────────
JIRA_ENABLED=false
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_API_TOKEN=
JIRA_USER_EMAIL=

# ── Confluence (optional) ─────────────────────────────────────────────────────
CONFLUENCE_ENABLED=false
CONFLUENCE_BASE_URL=https://yourcompany.atlassian.net
CONFLUENCE_API_TOKEN=

# ── LLM (optional) ───────────────────────────────────────────────────────────
# Set LLM_ENABLED=true and provide an API key to activate the "assisted" mode.
# When false (default), the stub provider is used — fully functional but no real AI.
LLM_ENABLED=false
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-4-6
ANTHROPIC_API_KEY=
